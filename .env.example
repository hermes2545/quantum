# ===== Runtime: ผู้ช่วย AI ในเว็บ (proxy) =====
ANTHROPIC_API_KEY=
MODEL=claude-opus-5
PORT=8787

# rate limit ตาม §9.5
RATE_DAY=30
RATE_MIN=5

# ===== Pipeline: เรียบเรียงเนื้อหาบท (§8 ขั้น author.py) =====
# spec §8 กำหนด "model tier สูงสุดที่มี"
AUTHOR_MODEL=claude-fable-5-1

# ===== A-01: เสิร์ฟ PDF ต้นฉบับในเมนูส่วนท้าย =====
# ได้รับอนุญาตจากผู้เขียนแล้ว — เปิดได้ทั้งเฟส 1 และ 2
SERVE_SOURCE_PDF=true

# effort ของผู้ช่วยตอบคำถาม (low|medium|high) — low พอสำหรับแชท และกัน thinking กิน max_tokens 800
ASK_EFFORT=low

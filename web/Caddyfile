":80 {
	# root ระดับ site เพื่อให้ handle_errors หา /404.html ได้แม้ error เกิดใน /api/*
	root * /srv

	# ผู้ช่วย API — ส่งตรงไปให้ proxy (ไม่ buffer SSE)
	handle /api/* {
		reverse_proxy proxy:8787 {
			flush_interval -1
			# ห้าม client ปลอม X-Forwarded-For มาเลี่ยง rate limit (§9.5) — ทับด้วย IP จริงของผู้เชื่อมต่อ
			header_up X-Forwarded-For {remote_host}
		}
	}

	# เนื้อหาและสินค้า
	handle {
		encode gzip

		# Routing: ให้ URL จริง /b/x/ch01 (ไม่มี slash ท้าย) ไปชี้ที่ไฟล์ index.html
		# โดยไม่ redirect ไปเป็น /b/x/ch01/ — ต้องเช็ค {path}/index.html ก่อน {path}
		# เพราะ /b/x/ch01 เป็นไดเรกทอรีจริง ถ้าเอา {path} ขึ้นก่อน file_server จะ
		# canonical-redirect (301) ไปมี trailing slash ทันที ขัด §0/§I
		try_files {path}/index.html {path}.html {path} =404

		# Serve ไฟล์จากดิสก์
		file_server

		# Cache assets นานๆ (CSS/JS รุ่นเป่า hash)
		@assets {
			path /assets/*
		}
		header @assets Cache-Control "public, max-age=3600"

		# HTML: ไม่ cache ให้ดึงใหม่ทุกครั้ง (ต้องไม่ทับกฎ cache ของ /assets/* ด้านบน)
		@html {
			not path /assets/*
		}
		header @html Cache-Control "no-cache"
	}

	# 404 handling
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

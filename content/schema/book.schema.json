{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhamma-science-learning.local/schema/book.schema.json",
  "title": "Book",
  "description": "content/books/{bookSlug}/book.json — ตาม §10 ของ handoff-spec.md และ §A.1 ของสัญญาระหว่างโมดูล + sourcePdf ตาม spec-addendum.md A-01",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "order", "title", "author", "blurb", "coreIdeas", "status", "chapters"],
  "properties": {
    "slug": {
      "type": "string",
      "description": "kebab-case ASCII ต้องตรงกับชื่อโฟลเดอร์ content/books/{slug}/",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "title": { "type": "string", "minLength": 1 },
    "author": {
      "type": "string",
      "const": "สิรวิชญ์ รัตน์จินดา",
      "description": "บังคับสะกดตรงเป๊ะเสมอทั้ง 9 เล่ม (§J ของสัญญาระหว่างโมดูล)"
    },
    "blurb": {
      "type": "string",
      "minLength": 1,
      "description": "คำโปรย 2-3 ประโยค เขียนใหม่ ห้ามคัดลอกจากหนังสือ (§9.1 ข้อ 1)"
    },
    "coreIdeas": {
      "type": "array",
      "description": "กล่อง .three บนหน้าแผนที่เล่ม — ยาว 3 พอดี",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "pali": { "type": "string" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["ready", "building"]
    },
    "sourcePdf": {
      "description": "optional (A-01) — ถ้าไม่มี = ยังไม่มีไฟล์ต้นฉบับสำหรับเล่มนี้",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "bytes"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "ชื่อไฟล์เปล่าใน content/source/ ห้ามมี '/' '\\' และห้ามเริ่มด้วย '.' (กัน path traversal)",
          "pattern": "^[^./\\\\][^/\\\\]*$"
        },
        "bytes": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "chapters": {
      "type": "array",
      "description": "ChapterMeta[] เรียงตาม order ต้องมีครบทุกบทของเล่ม (ว่างได้เฉพาะเมื่อ status ของเล่มเป็น building)",
      "items": { "$ref": "#/$defs/ChapterMeta" }
    }
  },
  "if": {
    "properties": { "status": { "const": "ready" } }
  },
  "then": {
    "properties": {
      "chapters": { "minItems": 1 }
    }
  },
  "$defs": {
    "ChapterMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "order", "thaiNum", "title", "sub", "status"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^ch[0-9]{2}$"
        },
        "order": { "type": "integer", "minimum": 1 },
        "thaiNum": {
          "type": "string",
          "pattern": "^[๐-๙]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "sub": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["draft", "ready", "building"],
          "description": "ต้องเท่ากับ chNN.json.status เสมอ — บังคับโดย validate.mjs (ไม่ใช่ JSON Schema เพราะเป็น cross-file check)"
        }
      }
    }
  }
}

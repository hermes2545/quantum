{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dhamma-science-learning.local/schema/index.schema.json",
  "title": "Index",
  "description": "content/index.json — generated โดย web/build.js (P4), P2 (proxy) อ่านไฟล์นี้ ตาม §A.4 ของสัญญาระหว่างโมดูล. content/index.example.json ต้อง valid ตามสคีมานี้ด้วย",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAt", "series", "books"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO string — เปลี่ยนทุก build; proxy ต้องไม่ใส่ฟิลด์นี้ลง prompt (กัน cache หลุด)"
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "author"],
      "properties": {
        "title": { "type": "string", "const": "ไตรลักษณ์ในควอนตัม" },
        "author": { "type": "string", "const": "สิรวิชญ์ รัตน์จินดา" }
      }
    },
    "books": {
      "type": "array",
      "description": "เรียงตาม order ครบทุกเล่มที่มีโฟลเดอร์ใน content/books/",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "order", "title", "author", "status", "chapters"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "order": { "type": "integer", "minimum": 1, "maximum": 9 },
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "const": "สิรวิชญ์ รัตน์จินดา" },
          "status": { "type": "string", "enum": ["ready", "building"] },
          "sourcePdf": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "bytes"],
            "properties": {
              "file": { "type": "string", "minLength": 1, "pattern": "^[^./\\\\][^/\\\\]*$" },
              "bytes": { "type": "integer", "exclusiveMinimum": 0 }
            }
          },
          "chapters": {
            "type": "array",
            "description": "ทุกบท รวมบท building ด้วย (summary มาจาก chNN.json.summary)",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "order", "thaiNum", "title", "status", "summary"],
              "properties": {
                "slug": { "type": "string", "pattern": "^ch[0-9]{2}$" },
                "order": { "type": "integer", "minimum": 1 },
                "thaiNum": { "type": "string", "pattern": "^[๐-๙]+$" },
                "title": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["draft", "ready", "building"] },
                "summary": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
